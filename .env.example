# Plantilla de variables. Copiar a .env.local y completar.
# En Vercel van en Settings -> Environment Variables (Production, Preview y
# Development). Solo las que empiezan con NEXT_PUBLIC_ llegan al navegador.

# --- Resend: el envio del formulario de contacto ---------------------------
# Se saca en https://resend.com/api-keys. Requiere el dominio verificado.
# Sin esta variable el formulario valida pero no envia, y lo dice en los logs.
RESEND_API_KEY=

# --- Cloudflare Turnstile: la verificacion anti-bot ------------------------
# Las dos salen de https://dash.cloudflare.com -> Turnstile -> Add widget.
# La de sitio es publica y viaja en el HTML; la secreta se queda en el servidor.
# Sin la secreta el formulario envia igual, sin verificar, y avisa en los logs.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
